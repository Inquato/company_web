# Public site URL (used for sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.example.com
# Resend (required for email notifications)
RESEND_API_KEY=
CONTACT_TO_EMAIL=            # where inquiries are delivered
CONTACT_FROM_EMAIL=          # a sender verified in Resend, e.g. "INQUATO <hello@yourdomain.com>"
# Supabase (optional: stores inquiries if both are set; table SQL in README)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=   # server only, never expose to the browser
# Public placeholders (replace with real details)
NEXT_PUBLIC_WHATSAPP_NUMBER= # digits only with country code
NEXT_PUBLIC_CONTACT_EMAIL=
